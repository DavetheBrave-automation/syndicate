# Trading mode — start in PAPER, only flip to LIVE after extended validation
TRADING_MODE=PAPER

# Kalshi API (https://kalshi.com/account/profile - generate API key)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# FRED (https://fredaccount.stlouisfed.org/apikeys - free)
FRED_API_KEY=

# Anthropic (for macro narrative scoring)
ANTHROPIC_API_KEY=

# Optional paid sources
COINGLASS_API_KEY=
QUIVER_API_KEY=

# Engine config
SCORE_THRESHOLD=60
OIL_BOOST=5
EXPOSURE_CAP_PCT=0.65
SPORTS_CAP_PCT=0.15
MIN_VOLUME=10
SCAN_INTERVAL_SEC=60

# Starting paper-trade portfolio
PAPER_STARTING_CASH=1000.00
